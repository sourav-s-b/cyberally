+def teacher_kl(pi, teacher_pi, mask):
+    """Mean KL(teacher || current) over valid (batch, time, agent) triples.
+
+    Both distributions are post-softmax masked probs with shape
+    (..., n_actions); mask has shape (..., ) with 1 on valid triples.
+    Unit-testable in isolation (see tests_blue/test_kl_teacher.py).
+    """
+    kl_triple = (teacher_pi * (th.log(teacher_pi + 1e-10)
+                               - th.log(pi + 1e-10))).sum(-1)
+    return (kl_triple * mask).sum() / mask.sum().clamp(min=1.0)
+
 
